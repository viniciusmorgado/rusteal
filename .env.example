# Development settings for working on Rusteal itself, read by `cargo xtask dev-setup`.
# Copy to .env (not versioned) and fill it in. The `rusteal` CLI never reads this
# file: games keep their engine path in the CLI's own configuration.

# Unreal Engine root, the directory holding Engine/.
#   Linux:   ~/.unreal/Linux_Unreal_Engine_5.8.2
#   Windows: C:\Program Files\Epic Games\UE_5.8
RUSTEAL_DEV_ENGINE_ROOT=
