use std::time::Duration;

use bindings::engine::{Actor, ActorComponentExt};
use bindings::niagara::NiagaraComponent;
use rusteal_runtime::runtime::timer::set_timer;
use rusteal_runtime::runtime::{RustealResult, UObjectRef, method};
use rusteal_runtime::{uclass, uclass_impl};

use crate::components;

use crate::trigger::TriggerSwitch;

const CONFETTI_DELAY: Duration = Duration::from_secs(1);

#[uclass(parent = Actor)]
pub struct ConfettiTrigger {
    #[uproperty(
        EditAnywhere,
        BlueprintReadWrite,
        name = "TriggerRef",
        category = "Confetti"
    )]
    trigger_ref: UObjectRef<TriggerSwitch>,

    #[uproperty(BlueprintReadOnly, category = "Confetti", default = false)]
    fired: bool,

    #[uproperty(BlueprintReadOnly, category = "Confetti", default = 0)]
    burst_count: i32,
}

impl ConfettiTrigger {
    fn niagara(&self) -> RustealResult<UObjectRef<NiagaraComponent>> {
        components::named(self.as_ref().upcast_to(), "Niagara")
    }
}

#[uclass_impl]
impl ConfettiTrigger {
    #[ufunction(Override)]
    fn receive_begin_play(&mut self) {
        if let Ok(trigger) = TriggerSwitch::from_obj(self.trigger_ref())
            && let Err(e) = trigger
                .trigger_add(method(self, Self::trigger_confetti))
                .map(|binding| binding.detach())
        {
            log::warn!("[Interactables] confetti: {e}");
        }
    }

    #[ufunction]
    fn trigger_confetti(&mut self) {
        if self.fired() {
            return;
        }

        self.set_fired(true);

        if let Err(e) = set_timer(
            &self.as_ref(),
            CONFETTI_DELAY,
            false,
            method(self, Self::burst),
        ) {
            log::warn!("[Interactables] confetti: {e}");
        }
    }

    #[ufunction]
    fn burst(&mut self) {
        self.set_burst_count(self.burst_count() + 1);

        if let Ok(niagara) = self.niagara().and_then(|n| n.checked()) {
            niagara.activate(Some(true));
        }
    }
}
