use bindings::engine::{Actor, ActorComponent, ActorExt};
use rusteal_runtime::runtime::{RustealError, RustealResult, SubclassOf, UObjectRef, UeClass};

pub fn named<'a, T: UeClass>(
    actor: UObjectRef<'a, Actor>,
    name: &str,
) -> RustealResult<UObjectRef<'a, T>> {
    actor
        .checked()?
        .k2_get_components_by_class(SubclassOf::<ActorComponent>::base())
        .into_iter()
        .find(|component| component.get_name().is_ok_and(|n| n == name))
        .ok_or_else(|| RustealError::invalid_operation(format!("no component {name}")))?
        .cast::<T>()
}
