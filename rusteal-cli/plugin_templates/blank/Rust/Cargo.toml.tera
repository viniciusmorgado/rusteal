# Cargo workspace of the {{ plugin }} plugin: its crate and the bindings
# generated by `rusteal build` from the project's Unreal Engine reflection data.
[workspace]
members = ["{{ crate_name }}", "bindings"]
resolver = "3"

[workspace.dependencies]
{%- if runtime_path %}
# Local Rusteal checkout (rusteal new --runtime-path).
rusteal-runtime = { path = "{{ runtime_path }}/rusteal-runtime" }
rusteal-core = { path = "{{ runtime_path }}/rusteal-core" }
rusteal-ffi = { path = "{{ runtime_path }}/rusteal-ffi" }
{%- else %}
rusteal-runtime = "={{ version }}"
rusteal-core = "={{ version }}"
rusteal-ffi = "={{ version }}"
{%- endif %}
glam = "{{ glam_version }}"

# The plugin's library is built with the dev profile while you iterate
# (`rusteal build`) and with the release profile to ship (`rusteal build
# --release`, `rusteal plugin package`).

# Iterating: a little optimization for the plugin's crate, which recompiles on
# every change, and full optimization for everything else, which compiles once.
[profile.dev]
opt-level = 1

[profile.dev.package."*"]
opt-level = 3

# The bindings are a workspace member, so `"*"` does not cover them; they only
# recompile when `rusteal build` regenerates them.
[profile.dev.package.bindings]
opt-level = 3

# Shipping: the fastest library, at the cost of longer builds.
[profile.release]
codegen-units = 1
lto = "thin"
