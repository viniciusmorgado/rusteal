use bindings::developer_settings::DeveloperSettings;
use rusteal_runtime::uclass;

#[uclass(parent = DeveloperSettings, config = "Game")]
pub struct {{ plugin }}Settings {
    #[uproperty(Config, EditAnywhere, category = "{{ plugin }}", default = 20)]
    max_slots: i32,
    #[uproperty(Config, EditAnywhere, category = "{{ plugin }}", default = 0.0)]
    max_weight: f32,
}
